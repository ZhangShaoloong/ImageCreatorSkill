# =============================================================================
# 厂商无关配置模板 — t2i-creator / i2i-creator
#
# 用法:复制本文件为 `.env`,填好值,然后用 `--env .env` 显式加载:
#   node image-generator.js "a cat" --env .env
# 或把下面变量 export 成系统环境变量后直接运行(无需 --env)。
#
# 优先级(高 → 低):
#   CLI flag  >  环境变量  >  ~/.claude/settings.local.json  >  内置 agnes 默认
# 即:不填任何配置时,skill 默认仍走 agnes(见下方默认值)。
# =============================================================================

# ---- 通用(厂商无关)----
# 你的 API key(通用命名,优先级高于 AGNES_API_KEY)
IMAGE_API_KEY=
# 你的 API 基础地址(OpenAI 兼容;末尾不带路径段)
IMAGE_API_BASE=            # 例:https://api.agnes-ai.cn/v1
# 你的模型 ID
IMAGE_MODEL=              # 例:agnes-image-2.1-flash

# ---- 兜底(仅当上方通用变量未设置时生效)----
# 不填时:IMAGE_API_KEY 回落到 AGNES_API_KEY;base 回落到 AGNES_API_BASE;
# 再不到 settings.local.json;最后到内置 agnes 默认。
# AGNES_API_KEY=
# AGNES_API_BASE=

# ---- 内置 agnes 默认值(什么都不填时生效,无需修改)----
# model:  agnes-image-2.1-flash
# base:   https://api.agnes-ai.cn/v1
